# Every variable the app reads. Server-only values never get a NEXT_PUBLIC_ prefix and never reach the browser.

# --- Supabase (use the Canada region, ca-central-1, for data residency) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by webhooks, cron, ETL, careers uploads and account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for the grants ETL (COPY). Use the session pooler or direct URL, not the transaction pooler.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Salt for hashing viewer IPs on share-link analytics (PIPEDA: no raw IPs stored).
SHARE_IP_SALT=change-me
# Team inbox for contact form, fit calls, quote requests, applications and alerts. Change without code edits.
CONTACT_INBOX_EMAIL=fundinglab.ca@gmail.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# "true" turns on Stripe Tax (GST/HST/PST) for service deposits and cohort checkout. Configure Stripe Tax first.
STRIPE_AUTOMATIC_TAX=false
# Optional recurring prices for partner membership tiers
STRIPE_PRICE_PARTNER_PRO=
STRIPE_PRICE_PARTNER_PREMIER=

# --- Email (Resend). If unset, emails are logged to the server console. ---
RESEND_API_KEY=
EMAIL_FROM="Funding Lab <hello@fundinglab.ca>"

# --- SMS (Twilio, opt-in reminders only). Leave blank to disable SMS. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Bot protection (Cloudflare Turnstile) on public forms. Leave both blank to disable. ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Grants ETL ---
# Proactive Disclosure – Grants and Contributions (Open Government Licence – Canada)
GRANTS_CSV_URL=https://open.canada.ca/data/dataset/432527ab-7aac-45b5-81d6-7597107a7013/resource/1d15a62f-5656-49ad-8c88-f40ce689d831/download/grants.csv

# --- Cron ---
# Protects /api/cron/* (.github/workflows/cron.yml sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=change-me
